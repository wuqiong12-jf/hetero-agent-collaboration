{
  "name": "relay-agent-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs scripts/*.test.mjs plugin/*.test.mjs",
    "package:plugin": "npm run build && node plugin/package.mjs",
    "install:plugin": "node scripts/native-plugin.mjs install"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
